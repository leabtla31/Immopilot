{
  "name": "immopilot",
  "version": "0.1.0",
  "private": true,
  "description": "ImmoPilot — Le copilote IA pour construire son patrimoine immobilier.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "build:demo": "STATIC_EXPORT=true next build && touch out/.nojekyll",
    "preview:demo": "pnpm dlx serve@14 out"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.104.5",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "framer-motion": "12.43.0",
    "lucide-react": "0.577.0",
    "maplibre-gl": "5.24.0",
    "next": "15.5.28",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "7.90.0",
    "recharts": "3.2.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "zod": "4.1.13",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@storybook/addon-a11y": "9.1.21",
    "@storybook/addon-docs": "9.1.21",
    "@storybook/nextjs-vite": "9.1.21",
    "@tailwindcss/postcss": "4.1.18",
    "@tanstack/react-query-devtools": "5.104.5",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "dotenv": "^16.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "9.1.21",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "16.4.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.6.14",
    "prisma": "6.19.3",
    "storybook": "9.1.21",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7"
  }
}
